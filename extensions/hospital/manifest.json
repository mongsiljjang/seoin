{
  "manifest_version": 3,
  "name": "병원 관리 앱 런처",
  "version": "1.0.0",
  "description": "재고·출퇴근·연월차 병원 관리 앱을 툴바 아이콘/단축키로 바로 엽니다.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "병원 관리 앱 열기"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "open-app": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "병원 관리 앱 열기"
    }
  }
}
