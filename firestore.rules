rules_version = '2';

// MediOps — 서버가 직접 막는다.
//
// 예전에는 "로그인만 했으면 전부 읽고 쓴다" 였다. 화면에서 가려도 데이터는
// 이미 그 사람 폰에 내려가 있었다. 이제 이 파일이 막는다.
//
// 누가 누구인지는 claims/{uid} 문서가 말해준다. 관리자가 승인한 기기만
// approved:true 가 되고, 승인되지 않은 기기는 아무것도 못 읽는다.
//
// 최초 병원 개설(첫 관리자)만 예외다. claims 가 비어 있는 동안에는 스스로
// 열 수 있어야 한다 — 아무도 승인해 줄 사람이 없기 때문이다. 첫 관리자가
// 생기는 순간 그 문이 닫힌다.

service cloud.firestore {
  match /databases/{database}/documents {

    // 이 앱을 만든 사람. 병원을 열어주고 구독 기한을 잡는다.
    // 앱에서는 만들 수도 지울 수도 없다 — 콘솔에서만 넣는다.
    // 앱 안에 뒷문을 두면 누구나 열 수 있어서, 잠김 복구 문과 같은 원칙을 쓴다.
    function isOperator() {
      return request.auth != null
          && exists(/databases/$(database)/documents/operators/$(request.auth.uid));
    }
    match /operators/{uid} {
      allow get:   if request.auth != null && (request.auth.uid == uid || isOperator());
      allow list:  if isOperator();
      allow write: if false;                       // 콘솔에서만
    }

    // 전체 설정. 개통 승인을 요구할지 여기서 켠다.
    // 이 문서가 없으면 예전처럼 누구나 새 병원을 열 수 있다 — 켜기 전에는 아무것도 안 막는다.
    function approvalRequired() {
      return exists(/databases/$(database)/documents/config/main)
          && get(/databases/$(database)/documents/config/main).data.get('requireApproval', false) == true;
    }
    match /config/{doc} {
      allow read:  if request.auth != null;
      allow write: if isOperator();
    }

    // 병원 명부. 제작자가 개통을 승인하면 여기 생긴다.
    match /hospitals/{ws} {
      allow get:   if request.auth != null;        // 병원도 자기가 승인됐는지는 알아야 한다
      allow list:  if isOperator();                // 다만 남의 병원 목록을 훑을 일은 없다
      allow write: if isOperator();
    }

    // 개설 신청 — 승인이 필요한데 아직 승인 안 된 병원이 남기는 쪽지.
    // 이름과 연락처만 담게 하고, 그 이상은 받지 않는다.
    match /hospreq/{ws} {
      allow get:    if request.auth != null;
      allow list:   if isOperator();
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['name','contact','at'])
                    && request.resource.data.get('name','').size() <= 60
                    && request.resource.data.get('contact','').size() <= 60;
      allow update, delete: if isOperator();
    }

    match /hospapp/{ws} {

      function claimPath() {
        return /databases/$(database)/documents/hospapp/$(ws)/claims/$(request.auth.uid);
      }
      function hasClaim() {
        return request.auth != null && exists(claimPath());
      }
      // 없는 필드를 그냥 읽으면 규칙이 터진다. 터진 규칙은 무조건 거절이라
      // 왜 막혔는지 알 수 없고, 목록 읽기는 문서 하나만 이상해도 통째로 막힌다.
      // 그래서 전부 기본값을 주고 읽는다.
      function claim() { return get(claimPath()).data; }
      function approved() {
        return hasClaim() && claim().get('approved', false) == true;
      }
      function isAdmin() {
        return approved() && (claim().get('role', '') in ['관리자', '인사담당자']);
      }
      function isOwner() {
        return approved() && claim().get('role', '') == '관리자';
      }
      function myStaffId() { return claim().get('staffId', ''); }

      // 아직 아무도 없는 병원인가 — 첫 관리자만 통과하는 문.
      // 문서가 있어도 명단이 비어 있으면 아직 연 것이 아니다. 앱이 시작하면서
      // 빈 명단을 먼저 저장하는 바람에, 정작 첫 관리자가 막히는 일이 있었다.
      function rosterPath() {
        return /databases/$(database)/documents/hospapp/$(ws)/roster/main;
      }
      function noClinicYet() {
        return !exists(rosterPath())
            || get(rosterPath()).data.get('staff', []).size() == 0;
      }

      // 잠겼을 때 나올 길. 관리자 기기를 전부 잃으면 아무도 승인해 줄 수 없어
      // 병원이 통째로 잠긴다. 그때 콘솔에서 recovery/open 문서를 만들면
      // 첫 관리자 문이 다시 열린다.
      //
      // 앱에서는 이 문서를 만들 수 없다(쓰기 금지). 콘솔에 들어갈 수 있는
      // 사람 — 즉 병원 주인 — 만 열 수 있다. 앱 안에 뒷문을 두지 않는 이유다.
      function recoveryPath() {
        return /databases/$(database)/documents/hospapp/$(ws)/recovery/open;
      }
      function recoveryOpen() {
        return exists(recoveryPath()) && get(recoveryPath()).data.get('open', false) == true;
      }
      // 개통 승인. 전체 설정이 꺼져 있으면 예전 그대로 열린다.
      function openApproved() {
        return !approvalRequired()
            || ( exists(/databases/$(database)/documents/hospitals/$(ws))
              && get(/databases/$(database)/documents/hospitals/$(ws)).data.get('approved', false) == true );
      }
      function bootstrapAllowed() {
        return (noClinicYet() && openApproved()) || recoveryOpen();
      }

      // 구독 기한. 개통 승인은 문을 열어줄 때 한 번만 작동해서 월 구독을 지키지 못한다.
      // 기한이 지나면 서버가 자료를 안 내려준다 — 화면에서 가리는 게 아니다.
      // 날짜는 서버 시계(request.time)로 재기 때문에 폰 시계를 바꿔도 소용없다.
      //
      // 문서가 없으면 통과시킨다. 구독 관리를 시작하기 전에 쓰던 병원이
      // 어느 날 갑자기 잠기면 안 된다.
      //
      // 자료를 지우지는 않는다. 기한을 미루면 그대로 살아나고, 잠긴 동안에도
      // 이미 기기에 내려가 있는 것으로 백업을 뽑을 수 있다.
      function licensePath() {
        return /databases/$(database)/documents/hospapp/$(ws)/license/main;
      }
      function licenseOk() {
        return !exists(licensePath())
            || ( get(licensePath()).data.get('status', 'active') != 'suspended'
              && get(licensePath()).data.get('paidUntil', request.time) > request.time );
      }

      // 최고관리자 아이디·비밀번호 — 서버가 대조한다.
      //
      // 실장이 원장을 대신하는 일이 잦아, 최고관리자는 어느 기기에서든 바로
      // 들어갈 수 있어야 한다. 그렇다고 앱이 스스로 열게 두면 뒷문이 된다.
      // 그래서 앱은 답을 모르고, 서버만 안다.
      //
      // 앱은 아이디·비밀번호를 늘려 만든 값(PBKDF2 25만 회)을 unlock 에 적는다.
      // 규칙의 get() 은 앱 권한과 무관하게 읽으므로, 앱이 못 읽는 ownerkey 와
      // 맞춰볼 수 있다. 틀리면 아무 일도 일어나지 않고, 맞았는지조차 알려주지
      // 않는다 — 한 번에 한 번씩만 물어볼 수 있다.
      function ownerKeyPath() {
        return /databases/$(database)/documents/hospapp/$(ws)/ownerkey/main;
      }
      function unlockPath() {
        return /databases/$(database)/documents/hospapp/$(ws)/unlock/$(request.auth.uid);
      }
      // 비밀번호를 잊었을 때 쓰는 한 번짜리 코드도 같이 대조한다.
      // 코드로 들어오면 앱이 곧바로 새 비밀번호를 정하게 하고 코드도 새로 발급한다 —
      // 앱은 ownerkey 를 읽지 못해서 쓴 코드 하나만 지우는 것이 불가능하기 때문이다.
      function ownerKeyMatches() {
        return exists(ownerKeyPath()) && exists(unlockPath())
            && ( get(ownerKeyPath()).data.get('hash', '@none') ==
                 get(unlockPath()).data.get('key', '@nope')
              || get(ownerKeyPath()).data.get('codes', []).hasAny(
                   [get(unlockPath()).data.get('key', '@nope')]) );
      }

      // 옛 단일 문서. 새 구조로 옮기는 동안만 읽는다. 쓰기는 막는다.
      allow read: if request.auth != null;
      allow write: if false;

      // 이 기기가 누구 것인가
      match /claims/{uid} {
        // 본인 것은 본인이 본다(승인 여부를 알아야 한다). 관리자는 다 본다.
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
        // 신청은 본인만. 스스로 승인할 수는 없다 — 아무도 없는 첫 개설만 예외.
        // approved 를 반드시 담게 한다. 없는 필드를 읽으면 규칙이 터지고,
        // 터진 규칙은 무조건 거절이라 왜 막혔는지 알 수 없다.
        allow create: if request.auth != null && request.auth.uid == uid
                      && (request.resource.data.get('approved', true) == false
                          || bootstrapAllowed()
                          || (request.resource.data.get('role', '') == '관리자' && ownerKeyMatches()));
        // 최고관리자 아이디·비밀번호로 들어오면 기기를 바꿔 다시 열 수도 있어야 한다
        allow update: if isAdmin()
                      || (request.auth != null && request.auth.uid == uid
                          && request.resource.data.get('role', '') == '관리자'
                          && ownerKeyMatches());
        // 본인은 자기 신청을 취소(삭제)할 수 있다.
        allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      }

      // 문 앞 표지판 — "이 병원에 사람이 있는가" 그것만 적혀 있다.
      // 승인 전 기기는 명단을 못 읽어서 빈 병원인지 알 수가 없다. 그러면 아무도
      // 받아줄 수 없는 신청서를 내고 막다른 길에 갇힌다. 이름도 번호도 없이
      // 있다/없다만 알려주는 문서를 따로 둔다.
      match /meta/{doc} {
        allow read:  if request.auth != null;
        allow write: if isAdmin() || bootstrapAllowed();
      }

      // 최고관리자 비밀번호의 정답. 앱은 절대 읽지 못한다 — 규칙만 읽는다.
      // 제작자는 지울 수만 있다. 지우면 병원은 '아이디가 아직 없어요' 로 돌아가고
      // 전화번호+PIN 으로 들어가 다시 정한다. 읽지는 못한다.
      match /ownerkey/{doc} {
        allow read:   if false;
        allow write:  if isAdmin() || bootstrapAllowed();
        allow delete: if isAdmin() || bootstrapAllowed() || isOperator();
      }

      // 구독 기한과 결제. 제작자만 쓴다. 병원은 남은 기간을 보려고 읽는다.
      // 수동(계좌이체 확인 후 제작자가 미룸)이든 자동(결제사가 미룸)이든
      // paidUntil 이라는 같은 칸 하나를 갱신하게 해서, 나중에 결제사를 붙일 때
      // 앱과 규칙을 고치지 않아도 되게 한다.
      match /license/{doc} {
        allow read:  if request.auth != null;
        allow write: if isOperator();
      }

      // 계량기. 요금 구간을 숫자 없이 정하면 또 추측이 된다. 병원이 실제로
      // 얼마나 쓰는지 세어 두는 자리다.
      //
      // 개수만 담는다 — 직원 명단도 사진도 여기 오지 않는다. 제작자가 병원
      // 안을 못 읽는다는 원칙은 그대로다.
      //
      // 한도(license)와 쓴 양(usage)을 나눠 둔 이유는 하나다. 병원이 자기
      // 한도를 늘리지 못하게 하려는 것이다 — 한도는 제작자만 쓴다.
      match /usage/{doc} {
        allow read:  if request.auth != null;
        allow write: if isAdmin() || bootstrapAllowed();
      }

      // 제작자가 병원에 손댄 기록. 병원도 봐야 한다 —
      // 남의 비밀번호를 초기화해 놓고 아무도 모르게 두면 안 된다.
      match /opslog/{doc} {
        allow read:  if request.auth != null;
        allow write: if isOperator();
      }

      // 사직서 링크. 관리자가 발급하면 퇴직자가 로그인 없이 그 주소로 들어와 낸다.
      // 퇴직자에게 앱을 열어주면 남의 개인정보가 같이 보이기 때문에 이 문서만 열어둔다.
      // 주소(토큰)를 아는 사람만 볼 수 있고, 목록으로 훑는 것은 관리자만 된다.
      match /resigninv/{token} {
        allow get:    if request.auth != null;
        allow list:   if isAdmin();
        allow write:  if isAdmin();
      }
      // 퇴직자가 낸 것. 한 번만 낼 수 있고, 낸 뒤에는 본인도 못 고친다.
      match /resignsub/{token} {
        allow get:    if isAdmin();
        allow list:   if isAdmin();
        allow create: if request.auth != null
                      && exists(/databases/$(database)/documents/hospapp/$(ws)/resigninv/$(token));
        allow update, delete: if isAdmin();
      }

      // 앱이 답안을 적어내는 곳. 쓰기만 되고 아무도 못 읽는다.
      // 맞았는지는 오직 '들어가졌는가' 로만 알 수 있다.
      match /unlock/{uid} {
        allow read:   if false;
        allow write:  if request.auth != null && request.auth.uid == uid;
      }

      // 복구 스위치 — 앱은 켜졌는지 볼 수만 있다. 만들고 지우는 건 콘솔에서.
      match /recovery/{doc} {
        allow read:  if request.auth != null;
        allow write: if false;
      }

      // 다 같이 보는 것 — 재고·출퇴근·연월차·공지·거래처
      match /shared/{doc} {
        allow read, write: if (approved() || bootstrapAllowed()) && licenseOk();
      }

      // 직원 명단 — PIN 은 여기 없다. 고치는 건 관리자만.
      match /roster/{doc} {
        allow read:  if approved() && licenseOk();
        allow write: if (isAdmin() || bootstrapAllowed()) && licenseOk();
      }

      // PIN 과 인사기록 — 관리자만. 직원 기기에는 아예 안 내려간다.
      match /secrets/{doc} {
        allow read, write: if (isAdmin() || bootstrapAllowed()) && licenseOk();
      }

      // 계약서·급여·신청서·사직서 — 본인과 관리자만
      match /people/{staffId} {
        allow read:  if (isAdmin() || (approved() && staffId == myStaffId())) && licenseOk();
        allow write: if (isAdmin() || (approved() && staffId == myStaffId()) || bootstrapAllowed()) && licenseOk();
      }
    }
  }
}
